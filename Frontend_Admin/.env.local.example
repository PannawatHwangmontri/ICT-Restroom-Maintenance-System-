# ============================================
# Frontend Environment Variables (EXAMPLE)
# คัดลอกไฟล์นี้ไปเป็น .env.local แล้วกรอกค่าจริง
# ============================================

# URL ของ Backend API
# - Development: http://localhost:3000
# - Production:  https://your-backend.railway.app
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# Secret สำหรับ sign/verify session cookie
# สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-random-hex-string
